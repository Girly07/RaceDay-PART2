@model List<dynamic>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Organiser Dashboard</h2>
        <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
    </div>

    <div class="row">
        @if (Model.Count > 0)
        {
            foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title text-dark">@ev.name</h5>
                            <p class="text-muted mb-2">📍 @ev.location</p>
                            <a href="#" class="btn btn-outline-primary btn-sm w-100">Manage Event</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">You haven't created any events yet.</div>
            </div>
        }
    </div>
</div>