@model dynamic
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-body text-center p-5">
                    @if (Model?.profilePictureUrl != null)
                    {
                        <img src="@Model.profilePictureUrl" alt="Profile" class="rounded-circle mb-3 shadow" style="width: 150px; height: 150px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary rounded-circle d-inline-flex justify-content-center align-items-center mb-3 shadow text-white" style="width: 150px; height: 150px; font-size: 50px;">
                            @Model?.firstName?.ToString().Substring(0, 1)
                        </div>
                    }

                    <h3>@Model?.firstName @Model?.lastName</h3>
                    <p class="text-muted">@Model?.email</p>

                    <hr />

                    <!-- File upload form (Mock Azure) -->
                    <form action="/Participant/UpdateProfile" method="post" enctype="multipart/form-data">
                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold">Update Profile Picture</label>
                            <input type="file" name="profilePic" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Upload via Azure Blob</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>