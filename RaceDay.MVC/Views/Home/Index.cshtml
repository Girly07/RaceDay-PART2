@model List<dynamic>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to RaceDay</h1>
    <p>Check out our upcoming events!</p>
</div>

<div class="row mt-5">
    @if (Model != null && Model.Count > 0)
    {
        foreach (var ev in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@ev.name</h5>
                        <p class="card-text">@ev.description</p>
                        <p class="card-text"><strong>Location:</strong> @ev.location</p>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center">
            <p class="text-danger">No events found, or the API is not running.</p>
            <p>Make sure your <strong>RaceDay.API</strong> project is running at the same time!</p>
        </div>
    }
</div>