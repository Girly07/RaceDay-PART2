@model List<dynamic>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">My Enrolments</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model.Count > 0)
    {
        <div class="row">
            @foreach (var enr in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h4 class="card-title">@enr.eventCategory.event.name</h4>
                            <p class="mb-1"><strong>Category:</strong> @enr.eventCategory.category.name</p>
                            <p class="mb-1"><strong>Date:</strong> @enr.eventCategory.event.eventDate.ToString("dd MMM yyyy")</p>
                            <span class="badge @(enr.status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">
                                Status: @enr.status
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">You haven't enrolled in any events yet.</div>
    }
</div>