@model List<dynamic>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">My Race Results</h2>

    @if (Model.Count > 0)
    {
        <table class="table table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var res in Model)
                {
                    <tr>
                        <td>@res.enrolment.eventCategory.event.name</td>
                        <td>@res.enrolment.eventCategory.category.name</td>
                        <td>@res.finishTime</td>
                        <td><strong>@res.position</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">You don't have any results yet. Keep running!</div>
    }
</div>